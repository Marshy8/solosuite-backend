# Backend — API scratchpad for the REST Client extension (humao.rest-client).
# Click the "Send Request" link that appears above each request.
#
# Prereqs:
#   - Server running locally: "Debug server", `npm run dev`, or `docker compose up --build -d`
#   - The Google-backed routes (calendar/*, timeOff/*, availability) need a valid
#     OAuth token first: open {{base}}/auth in a browser and complete the Google
#     consent screen once.
#   - The daySchedule, serviceType, and generalSettings routes are DB-only and
#     work without Google.

@base = http://localhost:3000


###############################################################################
# Auth (browser flow — not clickable here)
###############################################################################

# GET {{base}}/auth
#   Open this in a BROWSER, not the REST Client — it redirects to Google's
#   consent screen. After you approve, Google calls /oauth2callback and the
#   token is saved. You only need to do this once per token.


###############################################################################
# Calendar  (hits Google Calendar — needs OAuth)
###############################################################################

### List upcoming calendar events
GET {{base}}/calendar/events

### Create a raw calendar event (body is a Google Calendar event)
POST {{base}}/calendar/events
Content-Type: application/json

{
  "summary": "Test appointment",
  "start": { "dateTime": "2026-08-03T17:00:00", "timeZone": "America/New_York" },
  "end":   { "dateTime": "2026-08-03T17:30:00", "timeZone": "America/New_York" }
}


###############################################################################
# Day schedule  (DB-only — works without Google)
###############################################################################

### Get the whole week (all 7 days)
GET {{base}}/daySchedule

### Set a working day with hours
PUT {{base}}/daySchedule
Content-Type: application/json

{ "day": 2, "is_working": true, "start_time": "08:00", "end_time": "12:00" }

### Set a day off (nulls its hours)
PUT {{base}}/daySchedule
Content-Type: application/json

{ "day": 5, "is_working": false }

### Validation failure — bad day (expect 400)
PUT {{base}}/daySchedule
Content-Type: application/json

{ "day": 9, "is_working": false }

### Validation failure — bad time format (expect 400)
PUT {{base}}/daySchedule
Content-Type: application/json

{ "day": 2, "is_working": true, "start_time": "9am", "end_time": "12:00" }


###############################################################################
# Time off  (hits Google Calendar — needs OAuth)
###############################################################################

### Create a full-day time-off block
# The response includes the created event's "id" — copy it into the DELETE below.
POST {{base}}/timeOff
Content-Type: application/json

{
  "summary": "Vacation",
  "start": { "kind": "fullDay", "date": "2026-08-10" },
  "end":   { "kind": "fullDay", "date": "2026-08-17" }
}

### Create a specific-time time-off block (e.g. a dentist appointment)
POST {{base}}/timeOff
Content-Type: application/json

{
  "summary": "Dentist",
  "start": { "kind": "specificTime", "dateTime": "2026-08-10T12:00:00", "timeZone": "America/New_York" },
  "end":   { "kind": "specificTime", "dateTime": "2026-08-10T13:00:00", "timeZone": "America/New_York" }
}

### Validation failure — empty summary (expect 400)
POST {{base}}/timeOff
Content-Type: application/json

{
  "summary": "",
  "start": { "kind": "fullDay", "date": "2026-08-10" },
  "end":   { "kind": "fullDay", "date": "2026-08-17" }
}

### Delete a time-off block by its event id
# Replace PASTE_EVENT_ID_HERE with the "id" returned from a create above.
DELETE {{base}}/timeOff/25e24g74sq47mdrnmmm73kdvbc


###############################################################################
# Service type  (DB-only — works without Google)
###############################################################################

### List all service types (active and inactive)
GET {{base}}/serviceType/all

### List only active service types
GET {{base}}/serviceType/active

### Get a single service type by id
GET {{base}}/serviceType/6

### Create a service type
# "id" is ignored by the server (autoincrement) — send any placeholder value.
POST {{base}}/serviceType
Content-Type: application/json

{
  "id": -1,
  "name": "Kids Cut",
  "cost": 1800,
  "description": "Haircut for children under 12.",
  "duration_minutes": 20,
  "buffer_override_minutes": 5,
  "is_active": true
}

### Update an existing service type (id must match a real row)
# buffer_override_minutes: null means "no override" — falls back to
# general_settings.buffer_minutes for this service.
PUT {{base}}/serviceType
Content-Type: application/json

{
  "id": 1,
  "name": "Buzz Cut",
  "cost": 2200,
  "description": "Short clipper cut, all one length.",
  "duration_minutes": 15,
  "buffer_override_minutes": null,
  "is_active": true
}

### Validation failure — empty name (expect 400)
POST {{base}}/serviceType
Content-Type: application/json

{
  "id": -1,
  "name": "",
  "cost": 1800,
  "description": "desc",
  "duration_minutes": 20,
  "buffer_override_minutes": 0,
  "is_active": true
}

### Validation failure — negative cost (expect 400)
POST {{base}}/serviceType
Content-Type: application/json

{
  "id": -1,
  "name": "Broken",
  "cost": -100,
  "description": "desc",
  "duration_minutes": 20,
  "buffer_override_minutes": 0,
  "is_active": true
}

### Deactivate a service type by id (soft delete — sets is_active = 0)
DELETE {{base}}/serviceType/6


###############################################################################
# General settings  (DB-only, single row — works without Google)
###############################################################################

### Get the singleton settings row
GET {{base}}/generalSettings

### Update the settings row (id must always be 1)
PUT {{base}}/generalSettings
Content-Type: application/json

{
  "id": 1,
  "worker_name": "Buck Harris",
  "rolling_schedule_length": 60,
  "buffer_minutes": 15,
  "timezone": "America/New_York"
}

### Validation failure — rolling_schedule_length cannot be null (expect 400)
PUT {{base}}/generalSettings
Content-Type: application/json

{
  "id": 1,
  "worker_name": "Buck Harris",
  "rolling_schedule_length": null,
  "buffer_minutes": 15,
  "timezone": "America/New_York"
}

### Validation failure — buffer_minutes cannot be null (expect 400)
PUT {{base}}/generalSettings
Content-Type: application/json

{
  "id": 1,
  "worker_name": "Buck Harris",
  "rolling_schedule_length": 60,
  "buffer_minutes": null,
  "timezone": "America/New_York"
}

### Validation failure — id must be 1 (expect 400)
PUT {{base}}/generalSettings
Content-Type: application/json

{
  "id": 2,
  "worker_name": "Buck Harris",
  "rolling_schedule_length": 60,
  "buffer_minutes": 15,
  "timezone": "America/New_York"
}

### Validation failure — empty worker_name (expect 400)
PUT {{base}}/generalSettings
Content-Type: application/json

{
  "id": 1,
  "worker_name": "",
  "rolling_schedule_length": 60,
  "buffer_minutes": 15,
  "timezone": "America/New_York"
}

### Validation failure — negative buffer_minutes (expect 400)
PUT {{base}}/generalSettings
Content-Type: application/json

{
  "id": 1,
  "worker_name": "Buck Harris",
  "rolling_schedule_length": 60,
  "buffer_minutes": -5,
  "timezone": "America/New_York"
}

### Validation failure — invalid timezone (expect 400)
PUT {{base}}/generalSettings
Content-Type: application/json

{
  "id": 1,
  "worker_name": "Buck Harris",
  "rolling_schedule_length": 60,
  "buffer_minutes": 15,
  "timezone": "Not/A_Real_Zone"
}


###############################################################################
# Availability  (hits Google Calendar — needs OAuth)
###############################################################################
# Computes open booking slots: day_schedule's weekly working hours, over the
# rolling_schedule_length window, minus whatever's busy on the connected
# Google Calendar (padded by the service's buffer), sliced to 5-minute starts.

### Get open slots for a service type (Buzz Cut, id 1)
GET {{base}}/availability?serviceTypeId=1

### Get open slots for a service type with a buffer override (Hot Towel Shave, id 5)
GET {{base}}/availability?serviceTypeId=5

### Validation failure — missing serviceTypeId (expect 400)
GET {{base}}/availability

### Validation failure — unknown serviceTypeId (expect 400)
GET {{base}}/availability?serviceTypeId=9999

### Validation failure — deactivated service type (expect 400)
# Run the serviceType DELETE example above first, then try its id here.
GET {{base}}/availability?serviceTypeId=6


###############################################################################
# Client notes  (DB-only — works without Google)
###############################################################################
# One row per client, always overwritten — not a visit log. PUT both creates
# (client_identifier not seen before) and updates (client_identifier already
# has a row) via the same upsert.

### Get an existing client's note (seeded)
GET {{base}}/clientNotes/555-0101

### Get a client with no note yet (expect 200, empty body — no 404 handling yet)
GET {{base}}/clientNotes/555-0000

### Create a note for a brand-new client
PUT {{base}}/clientNotes
Content-Type: application/json

{
  "client_identifier": "555-0199",
  "client_name": "Casey Nguyen",
  "last_service_type_id": 1,
  "notes": "New client, wants a buzz cut every month."
}

### Update an existing client's note (overwrites the previous service + notes)
PUT {{base}}/clientNotes
Content-Type: application/json

{
  "client_identifier": "555-0101",
  "client_name": "Jordan Lee",
  "last_service_type_id": 4,
  "notes": "Switched to the haircut + beard combo."
}

### Validation failure — empty notes (expect 400)
PUT {{base}}/clientNotes
Content-Type: application/json

{
  "client_identifier": "555-0101",
  "client_name": "Jordan Lee",
  "last_service_type_id": 4,
  "notes": "   "
}


###############################################################################
# Booking  (hits Google Calendar — needs OAuth; DB-only for the notes lookup)
###############################################################################
# Client-facing flow: run GET /availability first to grab a real "start_time"
# from an open slot, then paste it in below. This route only READS
# client_notes (to enrich the event description for a returning client) —
# it never writes to client_notes. Writing/updating notes stays a
# separate, admin-side action via PUT /clientNotes above.

### Book a brand-new client (no prior note — plain description)
POST {{base}}/booking
Content-Type: application/json

{
  "client_identifier": "555-0299",
  "client_name": "Riley Chen",
  "service_type_id": 1,
  "start_time": "2026-09-01T14:00:00.000Z"
}

### Book a returning client (seeded note on 555-0101 — expect enriched description)
POST {{base}}/booking
Content-Type: application/json

{
  "client_identifier": "555-0101",
  "client_name": "Jordan Lee",
  "service_type_id": 2,
  "start_time": "2026-09-01T15:00:00.000Z"
}

### Validation failure — missing client_identifier (expect 400)
POST {{base}}/booking
Content-Type: application/json

{
  "client_name": "Riley Chen",
  "service_type_id": 1,
  "start_time": "2026-09-01T14:00:00.000Z"
}

### Validation failure — non-integer service_type_id (expect 400)
POST {{base}}/booking
Content-Type: application/json

{
  "client_identifier": "555-0299",
  "client_name": "Riley Chen",
  "service_type_id": "not-a-number",
  "start_time": "2026-09-01T14:00:00.000Z"
}

### Validation failure — empty start_time (expect 400)
POST {{base}}/booking
Content-Type: application/json

{
  "client_identifier": "555-0299",
  "client_name": "Riley Chen",
  "service_type_id": 1,
  "start_time": ""
}
